# Admin panel (Next.js) — kopyalayıp .env.local olarak kaydedin
# Canlı site kökü (favicon / OG mutlak URL; örn. https://gunubirlikaktivite.com)
NEXT_PUBLIC_SITE_URL=https://example.com

DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bodrum_aktivite
# EasyPanel/RDS gibi ortamlarda gerekirse:
# DATABASE_SSL=require

# İsteğe bağlı: yükleme dizini yanlış çözülürse (monorepo / yanlış cwd)
# NEXT_APP_ROOT=/absolute/path/to/bodrum-aktivite/apps/web
# veya yalnızca public:
# NEXT_APP_PUBLIC_DIR=/absolute/path/to/bodrum-aktivite/apps/web/public
# Kalıcı yükleme klasörü (EasyPanel volume mount önerilir)
# UPLOADS_DIR=/var/lib/banabivillam/uploads

ADMIN_PANEL_EMAIL=
ADMIN_PANEL_PASSWORD=
# En az 32 karakter rastgele dize: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Üye oturumu (boş bırakılırsa ADMIN_SESSION_SECRET kullanılır)
PUBLIC_USER_SESSION_SECRET=

# SMTP (PDF bilet e-postası — Ayarlar > Mail Şablon Yönetimi)
# Şifreyi asla repoya commit etmeyin; sadece .env.local içinde tutun.
SMTP_HOST=mail.12adalartekneturu.com
SMTP_PORT=465
# 465 için genelde true; 587 kullanırsanız SMTP_SECURE=false
SMTP_SECURE=true
SMTP_USER=rezervasyon@12adalartekneturu.com
SMTP_PASS=
# İsteğe bağlı; boşsa SMTP_USER From olarak kullanılır
SMTP_FROM=rezervasyon@12adalartekneturu.com
